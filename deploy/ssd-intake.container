# Podman Quadlet Container Definition
# Location on Proxmox Host: /etc/containers/systemd/ssd-intake.container
# Generated by Proxmox SSD Intake Project

[Unit]
Description=Proxmox SSD Intake Station (Web GUI)
Documentation=https://github.com/your-org/ssd-intake
After=network-online.target

[Container]
ContainerName=ssd-intake
Image=localhost/ssd-intake:latest

# Environment Configuration
Environment=SSD_INTAKE_HOST=127.0.0.1
Environment=SSD_INTAKE_PORT=7492
Environment=SSD_INTAKE_ROOT_DIR=/app/reports
# EnvironmentFile=/etc/default/ssd-intake.env

# Network Port Publishing (Binds to 127.0.0.1 on host by default for administrative safety)
PublishPort=127.0.0.1:7492:7492

# Container-Internal Reports Storage
# All reports & logs live strictly inside the container; nothing stays on the physical machine
Volume=ssd-intake-data:/app/reports:Z

# Host Diagnostic Access
# Required for smartctl ioctl pass-through, raw fio block device IO, and udev property inspection
Volume=/dev:/dev
Volume=/sys:/sys:ro
Volume=/run/udev:/run/udev:ro
Volume=/proc:/proc:ro

# Low-level block device access permissions
Privileged=true

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target default.target
