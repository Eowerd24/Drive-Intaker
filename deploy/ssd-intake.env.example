# ==============================================================================
# Proxmox SSD Intake Station - Environment Configuration
# ==============================================================================

# Web Server Bind Host (Default: 127.0.0.1 for local host only access)
# Set to trusted Proxmox management IP (e.g. 192.168.1.100) or 0.0.0.0 if behind a firewall
SSD_INTAKE_HOST=127.0.0.1

# Web Server Port (Default: 7492)
SSD_INTAKE_PORT=7492

# Storage Directory (Strictly inside the container - nothing stays on physical machine)
SSD_INTAKE_ROOT_DIR=/app/reports

# Explicit Protected System Disk Override (Optional)
# If left empty, the application auto-detects the host Proxmox boot/system disk
# Examples: /dev/sda or /dev/nvme0n1
SSD_INTAKE_SYSTEM_DISK=

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
SSD_INTAKE_LOG_LEVEL=INFO
